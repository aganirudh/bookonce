# Server-only Gemini key. Never prefix this value with VITE_ and never expose it to the browser.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional server-side model override.
GEMINI_MODEL=gemini-2.5-flash

# Optional server-only credentials for the transactional email endpoint.
GMAIL_EMAIL=your_gmail_address_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ============================================================================
# FREE APIs - NO API KEYS REQUIRED!
# ============================================================================

# Weather: Open-Meteo (https://open-meteo.com/)
# - Completely free, no API key needed
# - Unlimited requests
# - No registration required

# Geocoding: OpenStreetMap Nominatim (https://nominatim.openstreetmap.org/)
# - Completely free, no API key needed
# - Rate limit: 1 request/second (automatically handled)
# - No registration required

# Routing: OpenRouteService (https://openrouteservice.org/)
# - Free tier: 2000 requests/day
# - Optional API key for higher limits
# - Get key at: https://openrouteservice.org/dev/#/signup
# Server-only routing secret. Never prefix with VITE_.
OPENROUTE_API_KEY=

# Server-only RapidAPI flight-search configuration. Copy the exact host and
# search path from the subscribed Crawlio/skyscanner-flights4 RapidAPI console.
# Never prefix these values with VITE_.
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_SKYSCANNER_HOST=skyscanner-flights4.p.rapidapi.com
# Optional override for a future verified contract change.
RAPIDAPI_SKYSCANNER_SEARCH_PATH=/api/v1/search

# Server-only operational flight-status provider. Never prefix with VITE_.
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
